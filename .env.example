# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection for drizzle-kit CLI (db:push, db:migrate)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Cron job auth (set in Vercel for expired-link cleanup)
CRON_SECRET=generate-a-long-random-secret

# NextAuth
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# GitHub OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=

# Email — password reset (optional, logs in dev without key)
RESEND_API_KEY=
EMAIL_FROM=mikrouli.link <onboarding@resend.dev>

# Rate limiting — Upstash Redis (required in production; in-memory fallback for local dev only)
# Vercel KV integration also provisions KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIRECT_CACHE_TTL_SEC=300

# Stripe (optional, required for paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly price IDs
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Annual price IDs (for the monthly/annual toggle on /pricing)
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=

# Admin panel — comma-separated emails
ADMIN_EMAILS=you@example.com

# Sentry (optional — errors only, no tracing or replay)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
