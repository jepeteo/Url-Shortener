# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection for drizzle-kit CLI (db:push, db:migrate)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Cron job auth (set in Vercel for the daily expiry reminder + cleanup job)
CRON_SECRET=generate-a-long-random-secret
# Optional. When 1, the cron previews reminder counts and does not send or archive.
EXPIRY_EMAIL_DRY_RUN=

# NextAuth
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# GitHub OAuth (optional). New GitHub users are marked verified.
# Sign-in links to an existing account only when that account's email is already verified.
GITHUB_ID=
GITHUB_SECRET=

# Registration bot protection — optional Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email via Resend (optional in local dev — messages are logged instead of sent).
# Abuse reports are delivered to abuse@mikrouli.link with this same sender.
# In production, EMAIL_FROM must be on a domain verified in Resend.
# onboarding@resend.dev only delivers to the address on the Resend account.
RESEND_API_KEY=
EMAIL_FROM=mikrouli.link <onboarding@resend.dev>

# Rate limiting — Upstash Redis (required in production; in-memory fallback for local dev only)
# Vercel KV integration also provisions KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIRECT_CACHE_TTL_SEC=300

# Stripe (optional, required for paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly price IDs
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Annual price IDs (for the monthly/annual toggle on /pricing)
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BUSINESS_ANNUAL_PRICE_ID=

# Admin panel — comma-separated emails
ADMIN_EMAILS=you@example.com

# Sentry (optional — errors only, no tracing or replay)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
